{
    "name": "cart-relay/app",
    "description": "Import and export WooCommerce carts with simple CSV files using SKU and quantity.",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.2.0",
        "kucrut/vite-for-wp": "^0.12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "wp-coding-standards/wpcs": "^3.4.1"
    },
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Gilbert Rodríguez",
            "email": "gilbertrdz.dev@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "CartRelay\\App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CartRelay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check-version": "php tools/verify-version.php",
        "lint": "php tools/lint-php.php",
        "package": "php tools/build-package.php",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
