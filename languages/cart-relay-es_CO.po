#. Plugin Name of the plugin
#: cart-relay.php
msgid "Cart Relay for WooCommerce"
msgstr "Cart Relay para WooCommerce"

#. Description of the plugin
#: cart-relay.php
msgid "Import and export WooCommerce carts with simple CSV files using SKU and quantity."
msgstr "Importa y exporta carritos de WooCommerce con sencillos archivos CSV mediante SKU y cantidad."

#. Author of the plugin
